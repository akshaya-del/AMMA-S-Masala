<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Amma's Masala — Admin</title>
<style>
:root{
  --cream:#f8ecd4;
  --green:#174b3f;
  --green2:#0f3d34;
  --gold:#d4a017;
  --brown:#4a3427;
  --chili:#c1432d;
  --leaf:#3f7d5c;
  --whatsapp:#25D366;
  --bg:#f6f1e7;
  --line:#e8e0d0;
}
*{box-sizing:border-box;margin:0;padding:0}
[hidden]{display:none!important}
body{font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--brown);font-size:14px}
button,input,select,textarea{font:inherit}
button{cursor:pointer}

/* Login */
#loginScreen{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px}
.loginBox{background:#fff;padding:32px 26px;border-radius:12px;box-shadow:0 6px 20px rgba(0,0,0,.1);width:100%;max-width:360px;text-align:center}
.loginBox .brand{color:var(--green);font-weight:900;font-size:1.5rem}
.loginBox .brand small{display:block;color:var(--gold);font-size:.6rem;letter-spacing:3px}
.loginBox p{color:#777;margin:10px 0 18px}
.loginBox input{width:100%;padding:11px;border:1px solid #ddd;border-radius:6px;margin-bottom:10px}
.btn{background:var(--green);color:#fff;border:0;padding:9px 15px;border-radius:6px;font-weight:bold;text-decoration:none;display:inline-block}
.btn:hover{background:var(--green2)}
.btn.light{background:#fff;color:var(--green);border:1px solid var(--green)}
.btn.light:hover{background:var(--cream)}
.btn.wa{background:var(--whatsapp)}
.btn.block{width:100%}
.err{color:var(--chili);margin-top:8px;min-height:18px;font-size:.85rem}
.demoNote{background:#fff7e0;border:1px solid #f0dca0;color:#7a5a00;padding:8px 10px;border-radius:6px;font-size:.8rem;margin-top:12px;line-height:1.5;text-align:left}

/* App */
.topbar{background:#fff;border-bottom:1px solid var(--line);padding:12px 4%;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;position:sticky;top:0;z-index:20}
.topbar .brand{color:var(--green);font-weight:900;font-size:1.15rem}
.topbar .brand span{color:var(--gold);font-size:.75rem;letter-spacing:2px;margin-left:6px}
.live{font-size:.75rem;color:#888;margin-left:12px;font-weight:normal}
.live i{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--whatsapp);margin-right:5px;animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.3}}
.topActions{display:flex;gap:8px;flex-wrap:wrap}
main{padding:20px 4% 40px;max-width:1300px;margin:auto}

.newBanner{display:none;background:var(--green);color:#fff;padding:12px 16px;border-radius:10px;margin-bottom:16px;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.newBanner.show{display:flex}
.newBanner button{background:var(--gold);color:#fff;border:0;padding:7px 14px;border-radius:16px;font-weight:bold}

.stats{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:20px}
.stat{background:#fff;border-radius:10px;padding:14px 16px;border-left:4px solid var(--green);box-shadow:0 2px 6px rgba(0,0,0,.05)}
.stat:nth-child(2){border-color:var(--gold)}
.stat:nth-child(3){border-color:var(--leaf)}
.stat:nth-child(4){border-color:var(--chili)}
.stat:nth-child(5){border-color:#d9784f}
.stat:nth-child(6){border-color:#1d4f91}
.stat small{color:#888;text-transform:uppercase;font-size:.7rem;letter-spacing:.5px}
.stat b{display:block;font-size:1.45rem;color:var(--green);margin-top:4px}
.stat .hint{font-size:.72rem;color:#999;margin-top:2px}

.tabs{display:flex;gap:4px;border-bottom:2px solid var(--line);margin-bottom:14px;overflow-x:auto}
.tab{background:none;border:0;padding:10px 16px;color:#777;font-weight:bold;border-bottom:3px solid transparent;margin-bottom:-2px;white-space:nowrap}
.tab.active{color:var(--green);border-color:var(--green)}
.tab .count{background:var(--chili);color:#fff;border-radius:10px;padding:1px 7px;font-size:.7rem;margin-left:4px}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;align-items:center}
.toolbar input,.toolbar select{padding:9px 10px;border:1px solid #ddd;border-radius:6px;background:#fff}
.toolbar input{flex:1;min-width:200px}
.panel{background:#fff;border-radius:10px;box-shadow:0 2px 6px rgba(0,0,0,.05);overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:760px}
th{background:var(--cream);text-align:left;padding:10px 12px;font-size:.75rem;text-transform:uppercase;letter-spacing:.4px;color:#6b5646;white-space:nowrap}
td{padding:10px 12px;border-top:1px solid var(--line);vertical-align:top}
tr.clickable{cursor:pointer}
tr.clickable:hover td{background:#fbf8f2}
tr.isNew td{background:#eef8f1}
td .sub{color:#888;font-size:.8rem;display:block;margin-top:2px}
.amt{font-weight:bold;color:var(--green);white-space:nowrap}
.empty{padding:30px;text-align:center;color:#888}
.status{display:inline-block;padding:3px 10px;border-radius:12px;font-size:.75rem;font-weight:bold;white-space:nowrap}
.s-Pending{background:#fff3d6;color:#8a6200}
.s-Confirmed{background:#e3eefc;color:#1d4f91}
.s-Packed{background:#efe6fb;color:#5b2b91}
.s-Dispatched{background:#e1f3f6;color:#12606e}
.s-Delivered{background:#e3f4e8;color:#1f6b3a}
.s-Cancelled{background:#fbe4e0;color:#9a2a17}
.statusSel{padding:5px 6px;border:1px solid #ddd;border-radius:6px;background:#fff;font-size:.8rem}

/* Insights */
.insGrid{display:grid;grid-template-columns:1.2fr 1fr;gap:16px;margin-bottom:16px}
.card{background:#fff;border-radius:10px;box-shadow:0 2px 6px rgba(0,0,0,.05);padding:18px}
.card h3{color:var(--green);font-family:Georgia,serif;font-size:1.05rem;margin-bottom:4px}
.card .cardSub{color:#888;font-size:.8rem;margin-bottom:14px}
.tip{display:flex;gap:10px;padding:11px 12px;border-radius:8px;margin-bottom:8px;line-height:1.5;border-left:4px solid}
.tip b{display:block;color:var(--brown)}
.tip span{color:#666;font-size:.85rem}
.tip .ic{font-size:1.2rem;line-height:1.3}
.tip.high{background:#fdf0ed;border-color:var(--chili)}
.tip.mid{background:#fff8e6;border-color:var(--gold)}
.tip.good{background:#eef8f1;border-color:var(--leaf)}
.funnelRow{display:grid;grid-template-columns:130px 1fr 90px;gap:10px;align-items:center;margin-bottom:9px}
.funnelRow label{font-size:.85rem;color:#555}
.bar{background:#f1ece2;border-radius:4px;height:22px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--green);border-radius:4px;min-width:2px}
.funnelRow .num{text-align:right;font-size:.85rem}
.funnelRow .num b{color:var(--green)}
.funnelRow .num small{color:#999;display:block;font-size:.7rem}
.drop{font-size:.75rem;color:var(--chili);margin:-4px 0 8px 140px}
.miniGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:16px}
.kv{display:flex;justify-content:space-between;padding:7px 0;border-top:1px solid var(--line);font-size:.88rem}
.kv:first-of-type{border-top:0}
.kv b{color:var(--green)}
.hbar{display:grid;grid-template-columns:90px 1fr 34px;gap:8px;align-items:center;margin-bottom:6px;font-size:.8rem}
.hbar .bar{height:14px}
.hbar .bar i{background:var(--gold)}
.tag{display:inline-block;font-size:.7rem;padding:2px 8px;border-radius:10px;font-weight:bold}
.tag.bad{background:#fbe4e0;color:#9a2a17}
.tag.ok{background:#e3f4e8;color:#1f6b3a}
.tag.warn{background:#fff3d6;color:#8a6200}

/* Feedback */
.fb{background:#fff;border-radius:10px;padding:14px 16px;margin-bottom:10px;box-shadow:0 2px 6px rgba(0,0,0,.05)}
.fb .fbHead{display:flex;justify-content:space-between;gap:10px;color:#888;font-size:.8rem;margin-bottom:6px;flex-wrap:wrap}
.fb .fbType{font-weight:bold;color:var(--green)}
.fb p{line-height:1.6;white-space:pre-wrap}

/* Modal */
.overlay{display:none;position:fixed;inset:0;background:rgba(15,61,52,.55);z-index:50;align-items:center;justify-content:center;padding:16px}
.overlay.open{display:flex}
.modal{background:#fff;border-radius:12px;max-width:640px;width:100%;max-height:90vh;overflow-y:auto;padding:24px;position:relative}
.modalClose{position:absolute;top:12px;right:12px;border:0;background:#f3f3f3;width:32px;height:32px;border-radius:50%;color:#666}
.modal h2{color:var(--green);font-family:Georgia,serif;margin-bottom:4px}
.modal .meta{color:#888;margin-bottom:16px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}
.box{background:#fbf8f2;border:1px solid var(--line);border-radius:8px;padding:12px 14px;line-height:1.7}
.box h4{color:var(--green);font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
.modal table{min-width:0;margin-bottom:10px}
.modal td,.modal th{padding:8px 10px}
.totalRow td{font-weight:bold;color:var(--green);font-size:1.05rem}
.modal label{display:block;font-size:.75rem;text-transform:uppercase;color:#888;margin:12px 0 4px}
.modal textarea,.modal select{width:100%;padding:9px;border:1px solid #ddd;border-radius:6px}
.modalActions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--green2);color:#fff;padding:10px 18px;border-radius:20px;display:none;z-index:100}

@media(max-width:1000px){.stats{grid-template-columns:repeat(3,1fr)}.insGrid,.miniGrid{grid-template-columns:1fr}}
@media(max-width:560px){.grid2{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.stat b{font-size:1.2rem}.funnelRow{grid-template-columns:95px 1fr 70px}.drop{margin-left:105px}}
@media print{
  body *{visibility:hidden}
  #orderModal .modal, #orderModal .modal *{visibility:visible}
  #orderModal .modal{position:absolute;left:0;top:0;max-height:none;box-shadow:none}
  .modalClose,.modalActions,.noPrint{display:none!important}
}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="loginBox">
    <div class="brand">AMMA'S<small>MASALA · ADMIN</small></div>
    <p>Enter your admin key to view orders</p>
    <input type="password" id="adminKey" placeholder="Admin key" onkeydown="if(event.key==='Enter')login()">
    <button class="btn block" onclick="login()">Login</button>
    <div class="err" id="loginErr"></div>
    <div class="demoNote" id="demoNote" hidden>
      <b>Demo mode:</b> no Google Sheet connected yet (API_URL is empty), so only orders placed in
      <b>this same browser</b> on index.html are shown. Any key works. See setup steps in <code>apps-script.gs</code>.
    </div>
  </div>
</div>

<!-- DASHBOARD -->
<div id="app" hidden>
  <div class="topbar">
    <div class="brand">AMMA'S<span>ADMIN</span><span class="live" id="liveTxt"><i></i>Live</span></div>
    <div class="topActions">
      <button class="btn light" id="notifyBtn" onclick="enableNotifications()">🔔 Enable alerts</button>
      <button class="btn light" onclick="refresh(true)">⟳ Refresh</button>
      <button class="btn light" onclick="exportCSV()">⬇ Export CSV</button>
      <button class="btn" onclick="logout()">Logout</button>
    </div>
  </div>

  <main>
    <div class="newBanner" id="newBanner">
      <span id="newBannerTxt"></span>
      <button onclick="seeNewOrders()">View orders</button>
    </div>

    <div class="stats">
      <div class="stat"><small>Total Orders</small><b id="stTotal">0</b><div class="hint" id="stTotalHint"></div></div>
      <div class="stat"><small>Revenue</small><b id="stRevenue">₹0</b><div class="hint">excl. cancelled</div></div>
      <div class="stat"><small>Today's Orders</small><b id="stToday">0</b><div class="hint" id="stTodayHint"></div></div>
      <div class="stat"><small>Pending</small><b id="stPending">0</b><div class="hint">need confirming</div></div>
      <div class="stat"><small>Customers</small><b id="stCustomers">0</b><div class="hint" id="stRepeatHint"></div></div>
      <div class="stat"><small>Visitors (30d)</small><b id="stVisitors">0</b><div class="hint" id="stConvHint"></div></div>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="orders" onclick="showTab('orders')">📦 Orders <span class="count" id="pendingCount" hidden></span></button>
      <button class="tab" data-tab="insights" onclick="showTab('insights')">💡 Insights & Improve</button>
      <button class="tab" data-tab="customers" onclick="showTab('customers')">👤 Customers</button>
      <button class="tab" data-tab="products" onclick="showTab('products')">🌶️ Products</button>
      <button class="tab" data-tab="feedback" onclick="showTab('feedback')">💬 Feedback <span class="count" id="fbCount" hidden></span></button>
    </div>

    <!-- Orders -->
    <section id="tab-orders">
      <div class="toolbar">
        <input type="search" id="orderSearch" placeholder="Search order ID, name, phone, pincode, product..." oninput="renderOrders()">
        <select id="statusFilter" onchange="renderOrders()"><option value="all">All statuses</option></select>
        <select id="dateFilter" onchange="renderOrders()">
          <option value="all">All dates</option>
          <option value="today">Today</option>
          <option value="7">Last 7 days</option>
          <option value="30">Last 30 days</option>
        </select>
      </div>
      <div class="panel">
        <table>
          <thead><tr><th>Order ID</th><th>Date</th><th>Customer</th><th>Area / Pincode</th><th>Items</th><th>Amount</th><th>Payment</th><th>Status</th></tr></thead>
          <tbody id="ordersBody"></tbody>
        </table>
      </div>
    </section>

    <!-- Insights -->
    <section id="tab-insights" hidden>
      <div class="toolbar">
        <span style="color:#777">Period:</span>
        <select id="insPeriod" onchange="renderInsights()">
          <option value="7">Last 7 days</option>
          <option value="30" selected>Last 30 days</option>
          <option value="90">Last 90 days</option>
        </select>
      </div>
      <div class="insGrid">
        <div class="card">
          <h3>✅ What to improve</h3>
          <div class="cardSub">Suggestions worked out automatically from your orders, shop activity and feedback</div>
          <div id="tips"></div>
        </div>
        <div class="card">
          <h3>🛍️ Customer journey</h3>
          <div class="cardSub">How many shoppers reach each step, and where they leave</div>
          <div id="funnel"></div>
        </div>
      </div>
      <div class="miniGrid">
        <div class="card"><h3>📊 Key numbers</h3><div class="cardSub">For the selected period</div><div id="keyNums"></div></div>
        <div class="card"><h3>📍 Orders by area</h3><div class="cardSub">Where your customers are</div><div id="areaBars"></div></div>
        <div class="card"><h3>🗓️ Busiest days</h3><div class="cardSub">Orders by day of the week</div><div id="dayBars"></div></div>
      </div>
      <div class="card" style="padding:0">
        <div style="padding:18px 18px 10px"><h3>🌶️ Product performance</h3>
          <div class="cardSub" style="margin:0">Views = customers who opened the product. Conversion = orders ÷ views.</div></div>
        <div style="overflow-x:auto">
          <table>
            <thead><tr><th>Product</th><th>Views</th><th>Added to cart</th><th>Orders</th><th>Qty sold</th><th>Revenue</th><th>Conversion</th><th>Verdict</th></tr></thead>
            <tbody id="perfBody"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Customers -->
    <section id="tab-customers" hidden>
      <div class="toolbar">
        <input type="search" id="customerSearch" placeholder="Search name, phone, address..." oninput="renderCustomers()">
      </div>
      <div class="panel">
        <table>
          <thead><tr><th>Customer</th><th>Address</th><th>Orders</th><th>Total Spent</th><th>Last Order</th><th></th></tr></thead>
          <tbody id="customersBody"></tbody>
        </table>
      </div>
    </section>

    <!-- Products -->
    <section id="tab-products" hidden>
      <div class="panel">
        <table>
          <thead><tr><th>Product</th><th>Weights Ordered</th><th>Qty Sold</th><th>Revenue</th></tr></thead>
          <tbody id="productsBody"></tbody>
        </table>
      </div>
      <p style="color:#888;font-size:.8rem;margin-top:8px">All time. Cancelled orders are not counted.</p>
    </section>

    <!-- Feedback -->
    <section id="tab-feedback" hidden>
      <div class="toolbar">
        <select id="fbFilter" onchange="renderFeedback()">
          <option value="all">All feedback</option>
          <option>Question about my order</option>
          <option>Product idea / suggestion</option>
          <option>General query</option>
          <option>Compliment</option>
        </select>
      </div>
      <div id="feedbackList"></div>
    </section>
  </main>
</div>

<!-- ORDER DETAIL MODAL -->
<div class="overlay" id="orderModal" onclick="if(event.target===this)closeModal()">
  <div class="modal" id="modalContent"></div>
</div>

<div class="toast" id="toast"></div>

<script>
// Paste your Google Apps Script Web App URL here (the SAME one as in index.html)
const API_URL = "";

const POLL_SECONDS = 30;       // how often to check for new orders
const STATUSES = ["Pending","Confirmed","Packed","Dispatched","Delivered","Cancelled"];
const DAYS = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
let orders = [], events = [], feedback = [];
let adminKey = "";
let knownIds = null;           // order IDs already seen — used to detect new orders
let newIds = new Set();
let pollTimer = null;
const baseTitle = document.title;

const $ = id => document.getElementById(id);
const esc = s => String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const money = n => "₹" + Math.round(n || 0).toLocaleString("en-IN");
const pct = (a, b) => b ? Math.round(a / b * 100) : 0;
const fmtDate = d => { const x = new Date(d); return isNaN(x) ? esc(d) : x.toLocaleString("en-IN", {day:"2-digit",month:"short",year:"numeric",hour:"2-digit",minute:"2-digit"}); };
const itemCount = o => (o.items || []).reduce((s, i) => s + (i.qty || 0), 0);
const waNumber = phone => { const d = String(phone).replace(/\D/g, ""); return d.length === 10 ? "91" + d : d; };
const within = (d, days) => (Date.now() - new Date(d)) <= days * 86400000;

STATUSES.forEach(s => $("statusFilter").insertAdjacentHTML("beforeend", `<option value="${s}">${s}</option>`));
if (!API_URL) $("demoNote").hidden = false;

// ---------- Data ----------
async function api(payload) {
  const res = await fetch(API_URL, {
    method: "POST",
    headers: { "Content-Type": "text/plain;charset=utf-8" },  // avoids CORS preflight with Apps Script
    body: JSON.stringify(payload)
  });
  const data = await res.json();
  if (!data.ok) throw new Error(data.error || "Request failed");
  return data;
}

const readLocal = key => { try { return JSON.parse(localStorage.getItem(key) || "[]"); } catch (e) { return []; } };

async function fetchData() {
  if (API_URL) {
    const d = await api({ action: "list", key: adminKey });
    return { orders: d.orders || [], events: d.events || [], feedback: d.feedback || [] };
  }
  return { orders: readLocal("amma_orders"), events: readLocal("amma_events"), feedback: readLocal("amma_feedback") };
}

async function loadData(notify) {
  const d = await fetchData();
  orders = d.orders; events = d.events; feedback = d.feedback;
  orders.sort((a, b) => new Date(b.date) - new Date(a.date));
  feedback.sort((a, b) => new Date(b.date) - new Date(a.date));

  const ids = new Set(orders.map(o => o.id));
  if (knownIds && notify) {
    const fresh = orders.filter(o => !knownIds.has(o.id));
    if (fresh.length) announceNewOrders(fresh);
  }
  knownIds = ids;
  renderAll();
  $("liveTxt").innerHTML = `<i></i>Live · updated ${new Date().toLocaleTimeString("en-IN", {hour:"2-digit",minute:"2-digit"})}`;
}

async function saveOrderChange(id, changes) {
  const o = orders.find(x => x.id === id);
  if (!o) return;
  const before = { status: o.status, notes: o.notes };
  Object.assign(o, changes);
  renderAll();
  try {
    if (API_URL) {
      await api({ action: "update", key: adminKey, id, ...changes });
    } else {
      const all = readLocal("amma_orders");
      const x = all.find(a => a.id === id);
      if (x) Object.assign(x, changes);
      localStorage.setItem("amma_orders", JSON.stringify(all));
    }
    toast("Saved ✓");
  } catch (e) {
    Object.assign(o, before);
    renderAll();
    toast("Could not save: " + e.message);
  }
}

// ---------- New order alerts ----------
function announceNewOrders(fresh) {
  fresh.forEach(o => newIds.add(o.id));
  const n = newIds.size;
  const latest = fresh[0];
  $("newBannerTxt").innerHTML = `🎉 <b>${n} new order${n > 1 ? "s" : ""}!</b> Latest: ${esc(latest.name)} — ${money(latest.subtotal)} (${esc(latest.id)})`;
  $("newBanner").classList.add("show");
  document.title = `(${n}) New order${n > 1 ? "s" : ""} — ${baseTitle}`;
  beep();
  if ("Notification" in window && Notification.permission === "granted") {
    new Notification("🧺 New order — Amma's Masala", {
      body: `${latest.name} • ${money(latest.subtotal)} • ${itemCount(latest)} item(s)`
    });
  }
}

function seeNewOrders() {
  $("newBanner").classList.remove("show");
  document.title = baseTitle;
  $("orderSearch").value = ""; $("statusFilter").value = "all"; $("dateFilter").value = "all";
  showTab("orders");
  renderOrders();
  setTimeout(() => { newIds.clear(); }, 15000);   // keep new rows highlighted for a little while
}

function beep() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [880, 1175].forEach((f, i) => {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.frequency.value = f; o.connect(g); g.connect(ctx.destination);
      g.gain.setValueAtTime(0.15, ctx.currentTime + i * 0.18);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.18 + 0.16);
      o.start(ctx.currentTime + i * 0.18); o.stop(ctx.currentTime + i * 0.18 + 0.17);
    });
  } catch (e) {}
}

