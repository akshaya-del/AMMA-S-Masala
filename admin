// ---------- Insights ----------
function productStats(ordersP, eventsP) {
  const map = {};
  const get = name => map[name] || (map[name] = { name, views: 0, adds: 0, orders: 0, qty: 0, revenue: 0 });
  const viewSeen = new Set(), addSeen = new Set();
  eventsP.forEach(e => {
    if (!e.product) return;
    const k = e.session + "|" + e.product;
    if (e.type === "view" && !viewSeen.has(k)) { viewSeen.add(k); get(e.product).views++; }
    if (e.type === "add" && !addSeen.has(k)) { addSeen.add(k); get(e.product).adds++; }
  });
  ordersP.filter(o => o.status !== "Cancelled").forEach(o => {
    const inOrder = new Set();
    (o.items || []).forEach(i => {
      const p = get(i.name);
      p.qty += i.qty || 0;
      p.revenue += (i.qty || 0) * (i.priceUnit || 0);
      if (!inOrder.has(i.name)) { inOrder.add(i.name); p.orders++; }
    });
  });
  return Object.values(map);
}

function renderInsights() {
  const days = Number($("insPeriod").value);
  const oP = orders.filter(o => within(o.date, days));
  const eP = events.filter(e => within(e.date, days));
  const fP = feedback.filter(f => within(f.date, days));
  const active = oP.filter(o => o.status !== "Cancelled");

  // Funnel
  const visits = uniqueSessions(eP, "visit");
  const viewers = uniqueSessions(eP, "view");
  const adders = uniqueSessions(eP, "add");
  const checkouts = uniqueSessions(eP, "checkout");
  const placed = uniqueSessions(eP, "order");
  const steps = [
    ["Visited shop", visits], ["Viewed a product", viewers], ["Added to cart", adders],
    ["Opened checkout", checkouts], ["Placed order", placed]
  ];
  const top = Math.max(visits, 1);
  $("funnel").innerHTML = eP.length ? steps.map((s, i) => {
    const drop = i > 0 && steps[i - 1][1] > 0 ? steps[i - 1][1] - s[1] : 0;
    return `${i > 0 && drop > 0 ? `<div class="drop">↓ ${drop} left here (${pct(drop, steps[i - 1][1])}%)</div>` : ""}
      <div class="funnelRow"><label>${s[0]}</label>
        <div class="bar"><i style="width:${Math.min(100, pct(s[1], top))}%"></i></div>
        <div class="num"><b>${s[1]}</b><small>${pct(s[1], top)}% of visitors</small></div></div>`;
  }).join("") : `<div class="empty">No shop activity recorded yet in this period.</div>`;

  // Key numbers
  const revenue = active.reduce((s, o) => s + o.subtotal, 0);
  const aov = active.length ? revenue / active.length : 0;
  const cancelled = oP.filter(o => o.status === "Cancelled").length;
  const payCount = {};
  oP.forEach(o => payCount[o.payment] = (payCount[o.payment] || 0) + 1);
  const topPay = Object.entries(payCount).sort((a, b) => b[1] - a[1])[0];
  const customersAll = getCustomers();
  const phonesP = new Set(oP.map(o => waNumber(o.phone)));
  const repeatP = customersAll.filter(c => phonesP.has(waNumber(c.phone)) && c.orders > 1).length;
  $("keyNums").innerHTML = [
    ["Orders", oP.length], ["Revenue", money(revenue)], ["Average order value", money(aov)],
    ["Cancelled", `${cancelled} (${pct(cancelled, oP.length)}%)`],
    ["Repeat customers", `${repeatP} of ${phonesP.size}`],
    ["Most used payment", topPay ? `${esc(topPay[0])} (${pct(topPay[1], oP.length)}%)` : "—"],
    ["Feedback received", fP.length]
  ].map(([k, v]) => `<div class="kv"><span>${k}</span><b>${v}</b></div>`).join("");

  // Areas
  const areas = {};
  oP.forEach(o => { const a = o.location || "Not selected"; areas[a] = (areas[a] || 0) + 1; });
  const areaList = Object.entries(areas).sort((a, b) => b[1] - a[1]);
  const maxA = Math.max(1, ...areaList.map(a => a[1]));
  $("areaBars").innerHTML = areaList.length ? areaList.map(([a, n]) =>
    `<div class="hbar"><span>${esc(a)}</span><div class="bar"><i style="width:${pct(n, maxA)}%"></i></div><b>${n}</b></div>`).join("")
    : `<div class="empty">No orders yet.</div>`;

  // Days
  const dayC = [0, 0, 0, 0, 0, 0, 0];
  oP.forEach(o => dayC[new Date(o.date).getDay()]++);
  const maxD = Math.max(1, ...dayC);
  $("dayBars").innerHTML = oP.length ? dayC.map((n, i) =>
    `<div class="hbar"><span>${DAYS[i]}</span><div class="bar"><i style="width:${pct(n, maxD)}%"></i></div><b>${n}</b></div>`).join("")
    : `<div class="empty">No orders yet.</div>`;

  // Product performance
  const perf = productStats(oP, eP).sort((a, b) => b.revenue - a.revenue || b.views - a.views);
  $("perfBody").innerHTML = perf.length ? perf.map(p => {
    const conv = pct(p.orders, p.views);
    let verdict;
    if (p.views >= 5 && p.orders === 0) verdict = `<span class="tag bad">Viewed, never bought</span>`;
    else if (p.adds >= 3 && p.orders === 0) verdict = `<span class="tag bad">Left in carts</span>`;
    else if (p.views >= 5 && conv < 10) verdict = `<span class="tag warn">Low conversion</span>`;
    else if (p.orders >= 3) verdict = `<span class="tag ok">Selling well</span>`;
    else verdict = `<span style="color:#aaa">—</span>`;
    return `<tr><td><b>${esc(p.name)}</b></td><td>${p.views}</td><td>${p.adds}</td><td>${p.orders}</td>
      <td>${p.qty}</td><td class="amt">${money(p.revenue)}</td><td>${p.views ? conv + "%" : "—"}</td><td>${verdict}</td></tr>`;
  }).join("") : `<tr><td colspan="8" class="empty">No product data yet.</td></tr>`;

  // Suggestions
  $("tips").innerHTML = buildTips({ days, oP, eP, fP, active, visits, viewers, adders, checkouts, placed, aov, cancelled, perf, areaList, dayC, phonesP, repeatP, payCount })
    .map(t => `<div class="tip ${t.level}"><div class="ic">${t.icon}</div><div><b>${t.title}</b><span>${t.text}</span></div></div>`).join("");
}

function buildTips(d) {
  const tips = [];
  const add = (level, icon, title, text) => tips.push({ level, icon, title, text });

  if (!d.oP.length && !d.eP.length) {
    add("mid", "📣", "No activity yet in this period",
      "Share your shop link on WhatsApp status, family groups, Instagram and local Facebook groups to bring in your first visitors.");
    return tips;
  }

  // Pending orders waiting too long
  const stale = orders.filter(o => o.status === "Pending" && !within(o.date, 1));
  if (stale.length) add("high", "⏰", `${stale.length} order(s) still Pending for over 24 hours`,
    `Confirm them on WhatsApp today. Slow confirmation is the #1 reason customers cancel. (${stale.slice(0, 3).map(o => esc(o.id)).join(", ")}${stale.length > 3 ? "…" : ""})`);

  // Funnel drop-offs
  if (d.visits >= 10 && pct(d.viewers, d.visits) < 30)
    add("high", "👀", `Only ${pct(d.viewers, d.visits)}% of visitors open a product`,
      "Most people leave without looking at products. Use brighter, clearer product photos, show your offer at the top, and put best sellers first.");
  if (d.viewers >= 10 && pct(d.adders, d.viewers) < 20)
    add("high", "🛒", `Only ${pct(d.adders, d.viewers)}% of product viewers add to cart`,
      "Customers look but don't buy. Check if prices feel high, add a 100g trial size price upfront, and show reviews/ratings inside the product popup.");
  if (d.adders >= 5 && pct(d.checkouts, d.adders) < 50)
    add("mid", "🧾", `${d.adders - d.checkouts} shopper(s) added to cart but never opened checkout`,
      "Show the delivery charge and 'FREE delivery above ₹500' inside the cart, and make the 'Proceed to Checkout' button more visible.");
  if (d.checkouts >= 3 && pct(d.placed, d.checkouts) < 60)
    add("high", "📝", `${d.checkouts - d.placed} shopper(s) opened checkout but didn't place the order`,
      "The checkout form may feel long or they may not trust paying. Reassure with 'Cash on Delivery available', keep fields few, and add your phone number near the form.");

  // Products
  const neverBought = d.perf.filter(p => p.views >= 5 && p.orders === 0);
  if (neverBought.length) add("mid", "🌶️", `Viewed a lot but never bought: ${neverBought.slice(0, 3).map(p => esc(p.name)).join(", ")}`,
    "Review the price, photo and description for these. Try a small-pack price or add them to a combo with a best seller.");
  const leftInCart = d.perf.filter(p => p.adds >= 3 && p.orders === 0 && p.views < 5);
  if (leftInCart.length) add("mid", "🧺", `Often left in carts: ${leftInCart.slice(0, 3).map(p => esc(p.name)).join(", ")}`,
    "People want these but drop them. A small discount or free delivery push could convert them.");
  const best = d.perf.filter(p => p.orders > 0).sort((a, b) => b.qty - a.qty)[0];
  if (best) add("good", "⭐", `Best seller: ${esc(best.name)} (${best.qty} sold, ${money(best.revenue)})`,
    "Keep this always in stock, feature it at the top of the shop, and build a combo around it to lift order value.");

  // Order value
  if (d.active.length >= 3 && d.aov < 500)
    add("mid", "💰", `Average order is ${money(d.aov)} — below the ₹500 free-delivery mark`,
      "Suggest 'Add ₹X more for FREE delivery' in the cart, or promote combos (₹400+) so each order is bigger.");

  // Cancellations
  if (d.oP.length >= 5 && pct(d.cancelled, d.oP.length) > 10)
    add("high", "❌", `${pct(d.cancelled, d.oP.length)}% of orders were cancelled`,
      "Call or WhatsApp customers soon after they order, add notes on why each order was cancelled, and fix the most common reason.");

  // Repeat customers
  if (d.phonesP.size >= 5 && pct(d.repeatP, d.phonesP.size) < 20)
    add("mid", "🔁", `Only ${pct(d.repeatP, d.phonesP.size)}% of customers ordered again`,
      "Send a WhatsApp message 3–4 weeks after delivery (when their masala runs out) with a small repeat-order discount.");
  else if (d.phonesP.size >= 5)
    add("good", "🔁", `${pct(d.repeatP, d.phonesP.size)}% of customers come back`,
      "Customers like your products. Ask happy repeat customers for a review or photo to show on the shop.");

  // Areas
  if (d.areaList.length) {
    const noArea = d.areaList.find(a => a[0] === "Not selected");
    if (noArea && d.oP.length >= 5 && pct(noArea[1], d.oP.length) > 40)
      add("mid", "📍", `${pct(noArea[1], d.oP.length)}% of customers didn't choose a delivery area`,
        "Move the delivery-area buttons into the checkout form so you always know where to deliver.");
    const topArea = d.areaList.find(a => a[0] !== "Not selected");
    if (topArea) add("good", "📍", `Most orders come from ${esc(topArea[0])} (${topArea[1]})`,
      `Focus local promotions there — WhatsApp groups, apartment associations, local shops. Areas with few orders need more awareness.`);
  }

  // Busiest day
  if (d.oP.length >= 7) {
    const maxI = d.dayC.indexOf(Math.max(...d.dayC));
    add("good", "🗓️", `${DAYS[maxI]} is your busiest day`,
      `Post offers and WhatsApp status updates the day before (${DAYS[(maxI + 6) % 7]}) to catch customers when they plan their cooking.`);
  }

  // Payment
  const onlineShare = pct((d.payCount.UPI || 0) + (d.payCount.Online || 0), d.oP.length);
  if (d.oP.length >= 5 && onlineShare < 30)
    add("mid", "💳", `Most customers pay Cash on Delivery (${100 - onlineShare}%)`,
      "COD has more cancellations. Offer a small UPI discount (e.g. ₹10 off) to encourage prepaid orders.");

  // Feedback
  const questions = d.fP.filter(f => f.type === "Question about my order").length;
  const ideas = d.fP.filter(f => f.type === "Product idea / suggestion").length;
  if (questions) add("mid", "❓", `${questions} customer question(s) about orders`,
    "Customers are asking about their orders — send proactive 'Packed' and 'Dispatched' updates so they don't need to ask. See the Feedback tab.");
  if (ideas) add("good", "💡", `${ideas} product idea(s) from customers`,
    "Check the Feedback tab — customer ideas are a great way to choose your next product.");

  if (!d.eP.length && API_URL)
    add("mid", "🔌", "No shop activity data yet",
      "Make sure the same API_URL is pasted into index.html so visits, views and cart activity are recorded.");

  const order = { high: 0, mid: 1, good: 2 };
  return tips.sort((a, b) => order[a.level] - order[b.level]);
}

// ---------- Customers / products / feedback ----------
function getCustomers() {
  const map = {};
  orders.forEach(o => {
    const key = waNumber(o.phone);
    if (!map[key]) map[key] = { name: o.name, phone: o.phone, address: o.address, pincode: o.pincode, location: o.location, orders: 0, spent: 0, last: o.date };
    const c = map[key];
    c.orders++;
    if (o.status !== "Cancelled") c.spent += o.subtotal || 0;
    if (new Date(o.date) >= new Date(c.last)) Object.assign(c, { last: o.date, name: o.name, address: o.address, pincode: o.pincode, location: o.location });
  });
  return Object.values(map).sort((a, b) => b.spent - a.spent);
}

function renderCustomers() {
  const q = $("customerSearch").value.trim().toLowerCase();
  const list = getCustomers().filter(c => !q || [c.name, c.phone, c.address, c.pincode, c.location].join(" ").toLowerCase().includes(q));
  $("customersBody").innerHTML = list.length ? list.map(c => `
    <tr>
      <td><b>${esc(c.name)}</b> ${c.orders > 1 ? '<span class="tag ok">Repeat</span>' : ""}<span class="sub">📞 ${esc(c.phone)}</span></td>
      <td>${esc(c.address)}<span class="sub">${esc(c.location ? c.location + " · " : "")}${esc(c.pincode)}</span></td>
      <td>${c.orders}</td>
      <td class="amt">${money(c.spent)}</td>
      <td>${fmtDate(c.last)}</td>
      <td style="white-space:nowrap">
        <button class="btn light" onclick="viewCustomerOrders('${esc(c.phone)}')">Orders</button>
        <a class="btn wa" target="_blank" rel="noopener" href="https://wa.me/${waNumber(c.phone)}">WhatsApp</a>
      </td>
    </tr>`).join("") : `<tr><td colspan="6" class="empty">No customers yet.</td></tr>`;
}

function viewCustomerOrders(phone) {
  $("orderSearch").value = phone;
  $("statusFilter").value = "all";
  $("dateFilter").value = "all";
  showTab("orders");
  renderOrders();
}

function renderProducts() {
  const map = {};
  orders.filter(o => o.status !== "Cancelled").forEach(o => (o.items || []).forEach(i => {
    if (!map[i.name]) map[i.name] = { name: i.name, qty: 0, revenue: 0, weights: {} };
    const p = map[i.name];
    p.qty += i.qty || 0;
    p.revenue += (i.qty || 0) * (i.priceUnit || 0);
    p.weights[i.weight] = (p.weights[i.weight] || 0) + (i.qty || 0);
  }));
  const list = Object.values(map).sort((a, b) => b.revenue - a.revenue);
  $("productsBody").innerHTML = list.length ? list.map(p => `
    <tr>
      <td><b>${esc(p.name)}</b></td>
      <td>${Object.entries(p.weights).map(([w, q]) => `${esc(w)} × ${q}`).join(", ")}</td>
      <td>${p.qty}</td>
      <td class="amt">${money(p.revenue)}</td>
    </tr>`).join("") : `<tr><td colspan="4" class="empty">No sales yet.</td></tr>`;
}

function renderFeedback() {
