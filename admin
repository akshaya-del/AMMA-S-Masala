function openOrder(id) {
  const o = orders.find(x => x.id === id);
  if (!o) { toast("Order not found"); return; }
  const prevOrders = orders.filter(x => waNumber(x.phone) === waNumber(o.phone)).length;
  const waMsg = `Hi ${o.name}, this is Amma's Home Masala & Pickles. Your order ${o.id} is now: ${o.status}. Thank you!`;

  $("modalContent").innerHTML = `
    <button class="modalClose" onclick="closeModal()">✕</button>
    <h2>Order ${esc(o.id)}</h2>
    <div class="meta">${fmtDate(o.date)} &nbsp; <span class="status s-${esc(o.status)}">${esc(o.status)}</span></div>

    <div class="grid2">
      <div class="box">
        <h4>👤 Customer</h4>
        <b>${esc(o.name)}</b><br>
        📞 ${esc(o.phone)}<br>
        🧾 ${prevOrders} order(s) in total ${prevOrders > 1 ? '<span class="tag ok">Repeat</span>' : '<span class="tag warn">First order</span>'}
      </div>
      <div class="box">
        <h4>🏠 Delivery Address</h4>
        ${esc(o.address)}<br>
        Pincode: <b>${esc(o.pincode)}</b><br>
        ${o.location ? "Area: " + esc(o.location) : ""}
      </div>
    </div>

    <table>
      <thead><tr><th>Product</th><th>Weight</th><th>Qty</th><th>Price</th><th>Total</th></tr></thead>
      <tbody>
        ${(o.items || []).map(i => `<tr>
          <td>${esc(i.name)}</td><td>${esc(i.weight)}</td><td>${i.qty}</td>
          <td>${money(i.priceUnit)}</td><td class="amt">${money(i.qty * i.priceUnit)}</td></tr>`).join("")}
        <tr class="totalRow"><td colspan="4">Subtotal</td><td>${money(o.subtotal)}</td></tr>
      </tbody>
    </table>
    <div>💳 Payment method: <b>${esc(o.payment)}</b></div>

    <div class="noPrint">
      <label>Update status</label>
      <select id="mStatus">${STATUSES.map(s => `<option ${s === o.status ? "selected" : ""}>${s}</option>`).join("")}</select>
      <label>Admin notes (only you see this)</label>
      <textarea id="mNotes" rows="3" placeholder="e.g. Paid via UPI, dispatched with courier, cancelled because...">${esc(o.notes || "")}</textarea>
    </div>

    <div class="modalActions">
      <button class="btn" onclick="saveModal('${esc(o.id)}')">Save</button>
      <a class="btn wa" target="_blank" rel="noopener" href="https://wa.me/${waNumber(o.phone)}?text=${encodeURIComponent(waMsg)}">WhatsApp customer</a>
      <a class="btn light" href="tel:${esc(String(o.phone).replace(/[^\d+]/g, ""))}">📞 Call</a>
      <button class="btn light" onclick="window.print()">🖨 Print</button>
    </div>`;
  $("orderModal").classList.add("open");
}

function saveModal(id) {
  saveOrderChange(id, { status: $("mStatus").value, notes: $("mNotes").value });
  closeModal();
}
function closeModal() { $("orderModal").classList.remove("open"); }

// ---------- Export ----------
function exportCSV() {
  const cell = v => `"${String(v == null ? "" : v).replace(/"/g, '""')}"`;
  const rows = [["Order ID", "Date", "Name", "Phone", "Address", "Pincode", "Area", "Payment", "Items", "Subtotal", "Status", "Notes"]];
  orders.forEach(o => rows.push([
    o.id, new Date(o.date).toLocaleString("en-IN"), o.name, o.phone, o.address, o.pincode, o.location, o.payment,
    (o.items || []).map(i => `${i.name} (${i.weight}) x${i.qty}`).join("; "), o.subtotal, o.status, o.notes
  ]));
  const blob = new Blob(["﻿" + rows.map(r => r.map(cell).join(",")).join("\n")], { type: "text/csv" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = `amma-orders-${new Date().toISOString().slice(0, 10)}.csv`;
  a.click();
}

function toast(msg) {
  const t = $("toast");
  t.innerText = msg; t.style.display = "block";
  clearTimeout(t._h); t._h = setTimeout(() => t.style.display = "none", 2500);
}

// Auto-login if key saved in this tab
const saved = sessionStorage.getItem("amma_admin_key");
if (saved !== null) { $("adminKey").value = saved; login(); }
</script>
</body>
